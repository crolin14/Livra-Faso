# Configuration de production sécurisée pour LivraFaso
# Copier ce fichier vers .env et remplir avec les vraies valeurs

# SÉCURITÉ CRITIQUE
SECRET_KEY=your-super-secret-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip

# BASE DE DONNÉES
DB_NAME=livrafaso_prod
DB_USER=livrafaso_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@livrafaso.com

# REDIS CACHE
REDIS_URL=redis://127.0.0.1:6379/1

# APIs EXTERNES
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# MONITORING (optionnel)
SENTRY_DSN=your-sentry-dsn-url

# STOCKAGE FICHIERS (optionnel)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=your-region
